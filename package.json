{
  "name": "bnb-terminal-wallet",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Local non-custodial BNB Smart Chain terminal wallet",
  "license": "MIT",
  "author": "Jack Hudson <jackh109867@gmail.com>",
  "homepage": "https://github.com/jackh0006/bnb-terminal-wallet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackh0006/bnb-terminal-wallet.git"
  },
  "bugs": {
    "url": "https://github.com/jackh0006/bnb-terminal-wallet/issues"
  },
  "keywords": [
    "bnb",
    "bsc",
    "wallet",
    "bep20",
    "terminal",
    "non-custodial"
  ],
  "files": [
    "src",
    "tokens.json",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "bin": {
    "bnb-wallet": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "npm start",
    "check": "node --check src/index.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --test",
    "audit": "npm audit --omit=dev --audit-level=high",
    "prepare": "husky",
    "verify": "npm run lint && npm run format:check && npm run check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "ethers": "^6.15.0",
    "inquirer": "^12.5.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
